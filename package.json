    "@tanstack/react-query": "^5.107.1",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "next": "^16.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
