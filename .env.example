# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_NIMIQ_NETWORK=mainnet          # or testnet
AUTH_SECRET=change-me-to-32-random-bytes-base64   # openssl rand -base64 32

# Database: Postgres (Neon) in production. Leave empty to use the embedded PGlite file in .data/
DATABASE_URL=

# Nimiq JSON-RPC (server only, never NEXT_PUBLIC)
NIMIQ_RPC_URL=https://your-rpc.example
NIMIQ_RPC_URL_FALLBACK=
NIMIQ_RPC_AUTH=                             # "user:pass" if your RPC needs basic auth
NIMIQ_STAKING_CONTRACT=NQ77 0000 0000 0000 0000 0000 0000 0001

# Validators API
VALIDATORS_API_URL=https://validators-api-mainnet.pages.dev/api/v1/validators

# Optional
NEXT_PUBLIC_EXPLORER_TX_URL=https://nimiq.watch/#{hash}   # explorer link on /proof
PRICE_API_URL=                              # for "≈ fiat" display; hidden when empty
DEMO_ENABLED=true
